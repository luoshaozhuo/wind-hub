{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(git fetch *)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh run view *)",
      "Bash(python scripts/dev.py *)",
      "Bash(python3 scripts/dev.py *)",
      "Bash(python scripts/ci_gate.py *)",
      "Bash(python3 scripts/ci_gate.py *)",
      "Bash(python -m py_compile *)",
      "Bash(python3 -m py_compile *)",
      "Bash(python -m compileall *)",
      "Bash(python3 -m compileall *)",
      "Bash(ruff check *)",
      "Bash(python -m ruff check *)",
      "Bash(python3 -m ruff check *)",
      "Bash(mypy *)",
      "Bash(python -m mypy *)",
      "Bash(python3 -m mypy *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(docker compose * config)",
      "Bash(docker compose * ps)",
      "Bash(docker compose * logs *)",
      "Bash(command -v *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)",
      "Read(./**/*id_rsa*)",
      "Read(./**/*private_key*)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/ai_shared/agent_config/activate-env.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/ai_shared/agent_config/hooks/git-safety-gate.py"
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/ai_shared/agent_config/hooks/block-dangerous-bash.py"
          }
        ]
      }
    ]
  }
}
