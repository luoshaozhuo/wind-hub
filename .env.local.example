# ============================================================
# wind-hub 运行时环境变量模板
# 复制为 .env.local 并按实际情况修改
# ============================================================

# ------------------------------------------------------------
# 运行环境
# ------------------------------------------------------------
# 日志级别：DEBUG / INFO / WARNING / ERROR
WIND_HUB_LOG_LEVEL=INFO

# 配置目录（相对或绝对路径）
WIND_HUB_CONFIG_DIR=./configs

# ------------------------------------------------------------
# Web API
# ------------------------------------------------------------
# API 监听地址（默认 127.0.0.1，无认证，勿暴露公网）
WIND_HUB_API_HOST=127.0.0.1
WIND_HUB_API_PORT=8080

# ------------------------------------------------------------
# 协议驱动（可选）
# ------------------------------------------------------------
# ADS AMS Net ID（如果使用 ADS 协议）
# WIND_HUB_ADS_AMS_NET_ID=5.1.2.3.1.1

# Modbus 默认超时（秒）
# WIND_HUB_MODBUS_TIMEOUT=5.0

# IEC104 默认超时（秒）
# WIND_HUB_IEC104_T1_TIMEOUT=15.0
# WIND_HUB_IEC104_T2_TIMEOUT=10.0
# WIND_HUB_IEC104_T3_TIMEOUT=20.0

# ------------------------------------------------------------
# Sink 配置（可选）
# ------------------------------------------------------------
# Kafka Broker（如果使用 Kafka Sink）
# WIND_HUB_KAFKA_BROKER=localhost:9092

# 数据库连接串（如果使用 DB Sink）
# WIND_HUB_DB_DSN=postgresql://user:pass@localhost:5432/windhub

# ------------------------------------------------------------
# 开发/测试
# ------------------------------------------------------------
# 测试模式（1=启用，0=禁用）
WIND_HUB_TEST_MODE=0

# Prometheus 指标端口（如果启用 /metrics）
WIND_HUB_METRICS_PORT=9090
