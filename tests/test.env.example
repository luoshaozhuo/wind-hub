# wind-hub 测试环境变量模板。
# 复制为 tests/test.env（不入库）后按本机环境填写；进程环境变量优先于本文件。
# 未配置的真实服务对应测试会以 SKIPPED 报告，不会自动退化为 mock。

# 本地 Modbus 协议 fixture（tests/fixtures/servers/modbus_server.py）
WIND_HUB_TEST_MODBUS_HOST=127.0.0.1
WIND_HUB_TEST_MODBUS_PORT=15020

# 本地 IEC104 协议 fixture（tests/fixtures/servers/iec104_server.py）
WIND_HUB_TEST_IEC104_HOST=127.0.0.1
WIND_HUB_TEST_IEC104_PORT=12404

# 真实 Kafka。配置后直接使用该 broker；未配置时由
# tests/fixtures/services/docker-compose.yml 在本机 Docker 中拉起。
WIND_HUB_TEST_KAFKA=127.0.0.1:9092

# 真实 PostgreSQL。配置后直接使用该 DSN；未配置时走本机 Docker Compose。
WIND_HUB_TEST_POSTGRES_DSN=postgresql://windhub:windhub@127.0.0.1:5432/windhub

# 真实 TwinCAT ADS 环境。配置后 ADS 集成测试直连真实 PLC（hardware 资格）；
# 未配置时由 ads_service fixture 在进程内拉起 pyads AdsTestServer（real_service）。
WIND_HUB_TEST_ADS_HOST=
WIND_HUB_TEST_ADS_NET_ID=
WIND_HUB_TEST_ADS_PORT=801
WIND_HUB_TEST_ADS_READ_SYMBOL=
WIND_HUB_TEST_ADS_WRITE_SYMBOL=
WIND_HUB_TEST_ADS_LOCAL_NET_ID=
WIND_HUB_TEST_ADS_LOCAL_IP=
