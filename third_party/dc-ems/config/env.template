# 复制到发布包根 .env；仅支持 KEY=value，不执行 Shell、不展开变量、不支持引号。
DB_NAME=ems
DB_USER=postgres
DB_PASSWORD=dc-ems@2024
# DB_HOST/DB_PORT 仅用于宿主机部署；容器化固定连接 dc-ems-db:5432。
DB_HOST=127.0.0.1
DB_PORT=5432
HTTP_PORT=80
HTTPS_PORT=443
# server 容器监听的 HTTPS 端口（compose 端口映射 + sys_config web.listenPort）
SERVER_PORT=443
# server 容器 RMI 主备通信端口（compose 端口映射 + sys_config rmi.port）
RMI_PORT=9444
# 自签名证书 SAN 可改为正式访问域名/IP，例如 DNS:ems.example.com 或 IP:192.0.2.1。
JKS_SAN=DNS:localhost
# Redis 配置（SCADA 数据同步用，需外部 Redis 服务；对应 sys_config 表 sync/redisCon）
REDIS_HOST=redis
REDIS_PORT=6389
REDIS_PASSWORD=redis@123
REDIS_DB=0
# 节点角色：primary 或 standby。primary 启动 RMI Server 等待备机连接。
NODE_ROLE=primary
# 主备配置：主机（Primary）的宿主机 IP 地址。两台机器配相同值。
# 应用根据是否为本地 IP 自动判断主备角色；为空则单机运行（忽略 NODE_ROLE）。
PEER_HOST=
# 授权码（可选）：首次部署留空，deploy.sh 会打印机器码供申请授权；
# 获取授权码后填入此处并重新执行 deploy.sh 即可自动写入数据库。
LICENSE_CODE=
