{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/ai_shared/agent_config/hooks/block-git-write-ops.py\"",
            "timeout": 30,
            "statusMessage": "Blocking Git/GitHub write operations"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/ai_shared/agent_config/hooks/block-dangerous-bash.py\"",
            "timeout": 30,
            "statusMessage": "Checking dangerous shell command"
          }
        ]
      }
    ]
  }
}
