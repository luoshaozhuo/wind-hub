# Copy to deploy/.env and replace values for your isolated Linux host.
# Do not commit the populated .env file, tokens or certificates.
WIND_HUB_UID=1000
WIND_HUB_GID=1000
WIND_HUB_DEPLOY_ROOT=/srv/wind-hub
WIND_HUB_COLLECTOR_ADMIN_TOKEN=
WIND_HUB_COLLECTOR_TLS_CERT=/etc/wind-hub/certs/collector.pem
WIND_HUB_COLLECTOR_TLS_KEY=/etc/wind-hub/certs/collector.key
WIND_HUB_COLLECTOR_TLS_CA=/etc/wind-hub/certs/ca.pem
# Must refer to distinct service YAMLs with realtime/reliable delivery.
WIND_HUB_COLLECTOR_REALTIME_CONFIG=configs/services/service_collector-realtime_v1.1.0.yaml
WIND_HUB_COLLECTOR_RELIABLE_CONFIG=configs/services/service_collector-reliable_v1.0.0.yaml
WIND_HUB_COLLECTOR_REALTIME_PORT=50051
WIND_HUB_COLLECTOR_RELIABLE_PORT=50054
WIND_HUB_GATEWAY_CONFIG=configs/services/service_gateway_v1.2.0.yaml
WIND_HUB_DATA_GENERATOR_CONFIG=configs/services/service_data-generator_v1.1.0.yaml
WIND_HUB_COMMANDER_CONFIG=configs/services/service_commander_v1.4.0.yaml
