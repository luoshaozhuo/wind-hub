# Copy to deploy/.env and replace values for your isolated Linux host.
# Do not commit the populated .env file, tokens or certificates.
WIND_HUB_UID=1000
WIND_HUB_GID=1000
WIND_HUB_DEPLOY_ROOT=/srv/wind-hub
WIND_HUB_COLLECTOR_ADMIN_TOKEN=REPLACE_WITH_PRIVATE_TOKEN
# Must refer to distinct service YAMLs with realtime/reliable delivery.
WIND_HUB_COLLECTOR_REALTIME_CONFIG=configs/services/collector-realtime.yaml
WIND_HUB_COLLECTOR_RELIABLE_CONFIG=configs/services/collector-reliable.yaml
WIND_HUB_COLLECTOR_REALTIME_PORT=50051
WIND_HUB_COLLECTOR_RELIABLE_PORT=50054
WIND_HUB_GATEWAY_CONFIG=configs/services/industrial_gateway-sim.example.yaml
WIND_HUB_DATA_GENERATOR_CONFIG=configs/services/data-generator-sim.example.yaml
WIND_HUB_COMMANDER_CONFIG=configs/services/commander.yaml
