    async def _assert_nats_tasks_reaped() -> None:
        """Prove canceled NATS tasks finish instead of being collected by the GC."""
        deadline = asyncio.get_running_loop().time() + 5.0
        current = asyncio.current_task()
        while True:
            leaked = []
            for task in asyncio.all_tasks():
                if task is current or task.done():
                    continue
                coroutine = task.get_coro()
                name = getattr(coroutine, "__qualname__", "")
                if "Subscription._wait_for_msgs" in name or "Client._flusher" in name:
                    leaked.append(name)
            if not leaked:
                return
            if asyncio.get_running_loop().time() >= deadline:
                stacks = [
                    (
                        task.get_name(),
                        task.get_coro().cr_code.co_filename,
                        task.get_stack()[-1].f_lineno if task.get_stack() else task.get_coro().cr_code.co_firstlineno,
                    )
                    for task in asyncio.all_tasks()
                    if task is not current
                    and not task.done()
                    and any(
                        marker in getattr(task.get_coro(), "__qualname__", "")
                        for marker in ("Subscription._wait_for_msgs", "Client._flusher")
                    )
                ]
